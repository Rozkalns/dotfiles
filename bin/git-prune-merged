#!/usr/bin/env bash

# Delete local branches whose work is already in the default branch.
# Handles squash-merged GitLab MRs and GitHub PRs, which `git branch --merged` cannot see.
# The forge is picked from the origin URL: GitHub via `gh`, GitLab via `glab` (both need jq).
#
# Usage: git prune-merged [-n] [-y] [-w] [-s] [--closed] [-h]
#   -n, --dry-run   only print the plan
#   -y, --yes       delete without asking
#   -w, --worktrees also remove linked worktrees whose branch would be deleted
#   -s, --stashes   also drop stashes whose changes are already in the default branch
#   --closed        also delete branches whose MR/PR was closed without merge
#   -h              show this help (`git prune-merged --help` is taken by git, which looks
#                   for a man page that does not exist)
#   Short flags can be combined: -nw is -n -w.
#
# A branch is deleted when one of these is true:
#   merged      its tip is an ancestor of origin/<default>
#   in-base     merging it into origin/<default> changes nothing
#   mr-merged   its MR/PR is merged and the local tip has no commits after the MR/PR head
#   mr-closed   its MR/PR is closed (only with --closed)
# A branch kept because of its MR/PR (merged but with later commits, or closed without
# --closed) is listed with those commits; one whose patch already landed under another SHA
# is marked "same patch already in origin/<default>".
# Never touched: the default branch, the current branch, the main worktree's branch.
# A branch checked out in a linked worktree is only listed, unless -w is given. With -w its
# worktree is removed first, but only when it is unlocked and has no changes or untracked
# files. Ignored files in it (.env, vendor/, node_modules/) are deleted with it.
# A stash is dropped when applying it changes nothing:
#   in-base     on origin/<default> as it is now
#   landed      on some commit of origin/<default> since the stash was made (main moved on after)
# Untracked files in a stash must exist with the same content. Any other stash is kept; when
# some of its files landed, the commit and the files that differ are shown, to decide by hand.
# Every deleted branch is written as "<sha> <name>" to
# ~/.local/share/git-branch-backups/<repo>-<date>.txt – restore with `git branch <name> <sha>`.
# Dropped stashes go there as "<sha> stash <message>" – restore with `git stash store -m <message> <sha>`.

set -euo pipefail

dry_run=0
assume_yes=0
include_closed=0
include_worktrees=0
include_stashes=0

# Split bundled short flags: -nw becomes -n -w.
args=()
for arg in "$@"; do
  case "$arg" in
    -[!-]?*) for ((i = 1; i < ${#arg}; i++)); do args+=("-${arg:i:1}"); done ;;
    *) args+=("$arg") ;;
  esac
done

for arg in ${args[@]+"${args[@]}"}; do
  case "$arg" in
    -n|--dry-run) dry_run=1 ;;
    -y|--yes) assume_yes=1 ;;
    -w|--worktrees) include_worktrees=1 ;;
    -s|--stashes) include_stashes=1 ;;
    --closed) include_closed=1 ;;
    -h|--help) sed -n '3,36p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

git rev-parse --git-dir >/dev/null

echo "Fetching origin..."
git fetch --prune --quiet origin

default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
default_branch=${default_branch:-master}
base="origin/$default_branch"
base_tree=$(git rev-parse "$base^{tree}")
current_branch=$(git branch --show-current)

# One "<branch>\t<path>\t<main|linked>\t<locked|->" line per worktree with a branch checked out.
# The first entry of `git worktree list` is always the main worktree.
worktrees=$(git worktree list --porcelain | awk '
  /^worktree / { path = substr($0, 10); n++; branch = ""; locked = "-" }
  /^branch refs\/heads\// { branch = substr($0, 19) }
  /^locked/ { locked = "locked" }
  /^$/ { if (branch != "") print branch "\t" path "\t" (n == 1 ? "main" : "linked") "\t" locked; branch = "" }
  END { if (branch != "") print branch "\t" path "\t" (n == 1 ? "main" : "linked") "\t" locked }')

# Prints the worktree line for a branch, or nothing.
worktree_of() {
  printf '%s\n' "$worktrees" | awk -F '\t' -v b="$1" '$1 == b { print; exit }'
}

# Accepts git@host:owner/repo.git, ssh://git@host/owner/repo and https://host/owner/repo.
origin_url=$(git remote get-url origin)
origin_host=$(printf '%s' "$origin_url" | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#[:/].*$##')
origin_path=$(printf '%s' "$origin_url" | sed -E 's#^[a-z+]+://[^/]+/##; s#^[^@]*@[^:]*:##; s#\.git$##')

forge=""
if ! command -v jq >/dev/null; then
  echo "jq not available – skipping the MR/PR check (squash merges will be kept)." >&2
elif command -v gh >/dev/null && gh auth status --hostname "$origin_host" >/dev/null 2>&1; then
  forge="github"
elif command -v glab >/dev/null && glab auth status --hostname "$origin_host" >/dev/null 2>&1; then
  forge="gitlab"
else
  echo "No logged-in gh or glab for $origin_host – skipping the MR/PR check (squash merges will be kept)." >&2
fi

# Prints the merged MR/PR head SHA, "closed", or nothing.
mr_state() {
  local encoded response
  case "$forge" in
    github)
      response=$(gh pr list --repo "$origin_host/$origin_path" --head "$1" --state all --limit 20 \
        --json state,headRefOid 2>/dev/null) || return 0
      printf '%s' "$response" | jq -r '
        (map(select(.state == "MERGED")) | first | .headRefOid) //
        (if length > 0 and all(.state == "CLOSED") then "closed" else empty end)'
      ;;
    gitlab)
      encoded=$(printf '%s' "$1" | jq -sRr @uri)
      response=$(glab api "projects/:id/merge_requests?source_branch=$encoded&state=all&per_page=20" 2>/dev/null) || return 0
      printf '%s' "$response" | jq -r '
        (map(select(.state == "merged")) | first | .sha) //
        (if length > 0 and all(.state == "closed") then "closed" else empty end)'
      ;;
  esac
}

# Prints the commits on branch $1 after $2 (default: the base), newest first, at most 10.
# A commit whose patch is already in the base, under another SHA, is marked as such.
list_commits() {
  local listed
  listed=$(git cherry -v "$base" "$1" ${2:+"$2"} 2>/dev/null | awk -v base="$base" '
    { line = "        " substr($2, 1, 7) " " substr($0, index($0, $3)) }
    $1 == "-" { line = line "  (same patch already in " base ")" }
    { lines[NR] = line }
    END { for (i = NR; i > 0 && i > NR - 10; i--) print lines[i]; if (NR > 10) print "        … and " NR - 10 " more" }')
  [ -n "$listed" ] && printf '%s\n' "$listed" >&2
  return 0
}

delete_names=()
delete_reasons=()
delete_paths=()
kept=0
listed=""

while IFS= read -r branch; do
  [ "$branch" = "$default_branch" ] && continue
  [ "$branch" = "$current_branch" ] && continue

  wt_path=""
  wt=$(worktree_of "$branch")
  if [ -n "$wt" ]; then
    IFS=$'\t' read -r _ wt_path wt_kind wt_locked <<< "$wt"
    [ "$wt_kind" = "main" ] && continue
  fi

  reason=""
  if git merge-base --is-ancestor "$branch" "$base"; then
    reason="merged"
  elif [ "$(git merge-tree --write-tree "$base" "$branch" 2>/dev/null | head -1)" = "$base_tree" ]; then
    reason="in-base"
  elif [ -n "$forge" ]; then
    state=$(mr_state "$branch")
    if [ "$state" = "closed" ]; then
      if [ "$include_closed" -eq 1 ]; then
        reason="mr-closed"
      else
        echo "keep  $branch – MR/PR closed without merge (use --closed to delete); not in $base:" >&2
        list_commits "$branch"
      fi
    elif [ -n "$state" ]; then
      git cat-file -e "$state^{commit}" 2>/dev/null || git fetch --quiet origin "$state" 2>/dev/null || true
      if git merge-base --is-ancestor "$branch" "$state" 2>/dev/null; then
        reason="mr-merged"
      else
        echo "keep  $branch – MR/PR merged, but local branch has commits after the MR/PR head:" >&2
        list_commits "$branch" "$state"
      fi
    fi
  fi

  if [ -n "$reason" ] && [ -n "$wt_path" ]; then
    if [ "$include_worktrees" -ne 1 ]; then
      echo "list  $branch – $reason, checked out in worktree $wt_path (use -w to remove it)" >&2
      listed=$((${listed:-0} + 1))
      reason=""
    elif [ "$wt_locked" = "locked" ]; then
      echo "keep  $branch – $reason, but worktree $wt_path is locked" >&2
      reason=""
    elif [ ! -d "$wt_path" ]; then
      echo "keep  $branch – $reason, but worktree $wt_path is missing (run git worktree prune)" >&2
      reason=""
    elif [ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]; then
      echo "keep  $branch – $reason, but worktree $wt_path has changes or untracked files" >&2
      reason=""
    fi
  fi

  if [ -n "$reason" ]; then
    delete_names+=("$branch")
    delete_reasons+=("$reason")
    delete_paths+=("$wt_path")
  else
    kept=$((kept + 1))
  fi
done < <(git for-each-ref --format='%(refname:short)' refs/heads)

# True when applying stash $1 (made on $2) to commit $3 changes nothing, untracked files included.
stash_contained() {
  local result untracked_meta untracked_file
  result=$(git merge-tree --write-tree --merge-base "$2" "$3" "$1" 2>/dev/null | head -1) || return 1
  [ "$result" = "$(git rev-parse "$3^{tree}")" ] || return 1
  git rev-parse -q --verify "$1^3" >/dev/null || return 0
  while IFS=$'\t' read -r untracked_meta untracked_file; do
    [ "$(git rev-parse -q --verify "$3:$untracked_file" 2>/dev/null)" = "${untracked_meta##* }" ] || return 1
  done < <(git ls-tree -r "$1^3")
}

stash_shas=()
stash_reasons=()
stash_subjects=()
stashes_kept=0

if [ "$include_stashes" -eq 1 ]; then
  while IFS=' ' read -r stash_sha stash_subject; do
    stash_base=$(git rev-parse "$stash_sha^1")
    stash_files=$( { git diff --name-only "$stash_base" "$stash_sha"
      if git rev-parse -q --verify "$stash_sha^3" >/dev/null; then git ls-tree -r --name-only "$stash_sha^3"; fi; } | sort -u)
    scan_from=$(git merge-base "$stash_base" "$base" 2>/dev/null || true)

    reason=""
    if stash_contained "$stash_sha" "$stash_base" "$base"; then
      reason="in-base"
    elif [ -n "$scan_from" ] && [ -n "$stash_files" ]; then
      # Only commits touching the stash's files can change the answer.
      while IFS= read -r commit; do
        if stash_contained "$stash_sha" "$stash_base" "$commit"; then
          reason="landed"
          break
        fi
      done < <(printf '%s\n' "$stash_files" | tr '\n' '\0' | xargs -0 git rev-list --reverse --first-parent "$scan_from..$base" --)
    fi

    if [ -n "$reason" ]; then
      stash_shas+=("$stash_sha")
      stash_reasons+=("$reason")
      stash_subjects+=("$stash_subject")
      continue
    fi
    stashes_kept=$((stashes_kept + 1))

    # Hint: the commit where most of the stash's files have the stash's exact content.
    hint=""
    best=0
    total=$(printf '%s\n' "$stash_files" | grep -c . || true)
    if [ -n "$scan_from" ] && [ "$total" -gt 0 ]; then
      while IFS= read -r commit; do
        matched=0
        differs=()
        while IFS= read -r stash_file; do
          stash_blob=$(git rev-parse -q --verify "$stash_sha:$stash_file" 2>/dev/null ||
            git rev-parse -q --verify "$stash_sha^3:$stash_file" 2>/dev/null || true)
          if [ "$(git rev-parse -q --verify "$commit:$stash_file" 2>/dev/null || true)" = "$stash_blob" ]; then
            matched=$((matched + 1))
          else
            differs+=("$stash_file")
          fi
        done <<< "$stash_files"
        if [ "$matched" -gt "$best" ]; then
          best=$matched
          hint="$matched/$total files landed in $(git rev-parse --short "$commit"); differs: ${differs[*]:-none}"
        fi
      done < <(printf '%s\n' "$stash_files" | tr '\n' '\0' | xargs -0 git rev-list --first-parent "$scan_from..$base" --)
    fi
    echo "keep  $(git rev-parse --short "$stash_sha") $stash_subject${hint:+ – $hint}" >&2
  done < <(git stash list --format='%H %s')
fi

stash_note=""
[ "$include_stashes" -eq 1 ] && stash_note=", $stashes_kept stash(es) kept"

if [ ${#delete_names[@]} -eq 0 ] && [ ${#stash_shas[@]} -eq 0 ]; then
  echo "Nothing to delete. $kept branch(es) kept${listed:+, $listed of them in worktrees (use -w)}${stash_note}."
  exit 0
fi

echo
for i in "${!delete_names[@]}"; do
  if [ -n "${delete_paths[$i]}" ]; then
    printf '  %-10s %s  (+ worktree %s)\n' "${delete_reasons[$i]}" "${delete_names[$i]}" "${delete_paths[$i]}"
  else
    printf '  %-10s %s\n' "${delete_reasons[$i]}" "${delete_names[$i]}"
  fi
done
for i in "${!stash_shas[@]}"; do
  printf '  %-10s stash %s %s\n' "${stash_reasons[$i]}" "$(git rev-parse --short "${stash_shas[$i]}")" "${stash_subjects[$i]}"
done
echo
echo "${#delete_names[@]} branch(es) to delete, $kept kept${listed:+, $listed of them in worktrees (use -w)}."
[ "$include_stashes" -eq 1 ] && echo "${#stash_shas[@]} stash(es) to drop, $stashes_kept kept."

[ "$dry_run" -eq 1 ] && exit 0

if [ "$assume_yes" -ne 1 ]; then
  read -r -p "Delete them? [y/N] " answer
  case "$answer" in
    y|Y|yes) ;;
    *) echo "Aborted."; exit 1 ;;
  esac
fi

# A worktree that git refuses to remove keeps its branch: `git branch -D` would fail on it anyway.
branches=()
for i in "${!delete_names[@]}"; do
  if [ -n "${delete_paths[$i]}" ]; then
    if git worktree remove "${delete_paths[$i]}"; then
      echo "Removed worktree ${delete_paths[$i]}"
    else
      echo "keep  ${delete_names[$i]} – could not remove worktree ${delete_paths[$i]}" >&2
      continue
    fi
  fi
  branches+=("${delete_names[$i]}")
done

if [ ${#branches[@]} -eq 0 ] && [ ${#stash_shas[@]} -eq 0 ]; then
  echo "Nothing deleted."
  exit 1
fi

# The main worktree's name, so a run from a linked worktree writes to the same backup file.
backup_dir="$HOME/.local/share/git-branch-backups"
backup_file="$backup_dir/$(basename "$(git worktree list --porcelain | sed -n '1s#^worktree ##p')")-$(date +%F).txt"
mkdir -p "$backup_dir"

if [ ${#branches[@]} -gt 0 ]; then
  for branch in "${branches[@]}"; do
    printf '%s %s\n' "$(git rev-parse "$branch")" "$branch"
  done >> "$backup_file"

  git branch -D --quiet "${branches[@]}"
  echo "Deleted ${#branches[@]} branch(es). SHAs saved to $backup_file"
fi

# Dropped by SHA, highest index first, so an earlier drop never shifts a later stash@{n}.
dropped=0
if [ ${#stash_shas[@]} -gt 0 ]; then
  while IFS=' ' read -r stash_ref stash_sha; do
    for i in "${!stash_shas[@]}"; do
      [ "$stash_sha" = "${stash_shas[$i]}" ] || continue
      printf '%s stash %s\n' "$stash_sha" "${stash_subjects[$i]}" >> "$backup_file"
      git stash drop --quiet "$stash_ref"
      dropped=$((dropped + 1))
    done
  done < <(git stash list --format='%gd %H' | sort -t '{' -k2 -rn)
  echo "Dropped $dropped stash(es). SHAs saved to $backup_file"
fi

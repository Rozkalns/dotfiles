#!/usr/bin/env bash

# Delete local branches whose work is already in the default branch.
# Handles squash-merged GitLab MRs, which `git branch --merged` cannot see.
#
# Usage: git prune-merged [-n] [-y] [--closed]
#   -n, --dry-run   only print the plan
#   -y, --yes       delete without asking
#   --closed        also delete branches whose MR was closed without merge
#
# A branch is deleted when one of these is true:
#   merged      its tip is an ancestor of origin/<default>
#   in-base     merging it into origin/<default> changes nothing
#   mr-merged   its GitLab MR is merged and the local tip has no commits after the MR head
#   mr-closed   its GitLab MR is closed (only with --closed)
# Never touched: the default branch, the current branch, branches checked out in a worktree.
# Every deleted branch is written as "<sha> <name>" to
# ~/.local/share/git-branch-backups/<repo>-<date>.txt – restore with `git branch <name> <sha>`.

set -euo pipefail

dry_run=0
assume_yes=0
include_closed=0

for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) dry_run=1 ;;
    -y|--yes) assume_yes=1 ;;
    --closed) include_closed=1 ;;
    -h|--help) sed -n '3,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

git rev-parse --git-dir >/dev/null

echo "Fetching origin..."
git fetch --prune --quiet origin

default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
default_branch=${default_branch:-master}
base="origin/$default_branch"
base_tree=$(git rev-parse "$base^{tree}")
current_branch=$(git branch --show-current)
worktree_branches=$(git worktree list --porcelain | sed -n 's#^branch refs/heads/##p')

use_gitlab=0
if command -v glab >/dev/null && command -v jq >/dev/null && glab auth status >/dev/null 2>&1; then
  use_gitlab=1
else
  echo "glab or jq not available – skipping the GitLab MR check (squash merges will be kept)." >&2
fi

# Prints the merged MR head SHA, "closed", or nothing.
gitlab_mr_state() {
  local encoded mrs
  encoded=$(printf '%s' "$1" | jq -sRr @uri)
  mrs=$(glab api "projects/:id/merge_requests?source_branch=$encoded&state=all&per_page=20" 2>/dev/null) || return 0
  printf '%s' "$mrs" | jq -r '
    (map(select(.state == "merged")) | first | .sha) //
    (if length > 0 and all(.state == "closed") then "closed" else empty end)'
}

delete_names=()
delete_reasons=()
kept=0

while IFS= read -r branch; do
  [ "$branch" = "$default_branch" ] && continue
  [ "$branch" = "$current_branch" ] && continue
  if printf '%s\n' "$worktree_branches" | grep -qxF -- "$branch"; then
    continue
  fi

  reason=""
  if git merge-base --is-ancestor "$branch" "$base"; then
    reason="merged"
  elif [ "$(git merge-tree --write-tree "$base" "$branch" 2>/dev/null | head -1)" = "$base_tree" ]; then
    reason="in-base"
  elif [ "$use_gitlab" -eq 1 ]; then
    state=$(gitlab_mr_state "$branch")
    if [ "$state" = "closed" ]; then
      [ "$include_closed" -eq 1 ] && reason="mr-closed"
    elif [ -n "$state" ]; then
      git cat-file -e "$state^{commit}" 2>/dev/null || git fetch --quiet origin "$state" 2>/dev/null || true
      if git merge-base --is-ancestor "$branch" "$state" 2>/dev/null; then
        reason="mr-merged"
      else
        echo "keep  $branch – MR merged, but local branch has commits after the MR head" >&2
      fi
    fi
  fi

  if [ -n "$reason" ]; then
    delete_names+=("$branch")
    delete_reasons+=("$reason")
  else
    kept=$((kept + 1))
  fi
done < <(git for-each-ref --format='%(refname:short)' refs/heads)

if [ ${#delete_names[@]} -eq 0 ]; then
  echo "Nothing to delete. $kept branch(es) kept."
  exit 0
fi

echo
for i in "${!delete_names[@]}"; do
  printf '  %-10s %s\n' "${delete_reasons[$i]}" "${delete_names[$i]}"
done
echo
echo "${#delete_names[@]} branch(es) to delete, $kept kept."

[ "$dry_run" -eq 1 ] && exit 0

if [ "$assume_yes" -ne 1 ]; then
  read -r -p "Delete them? [y/N] " answer
  case "$answer" in
    y|Y|yes) ;;
    *) echo "Aborted."; exit 1 ;;
  esac
fi

backup_dir="$HOME/.local/share/git-branch-backups"
backup_file="$backup_dir/$(basename "$(git rev-parse --show-toplevel)")-$(date +%F).txt"
mkdir -p "$backup_dir"
for branch in "${delete_names[@]}"; do
  printf '%s %s\n' "$(git rev-parse "$branch")" "$branch"
done >> "$backup_file"

git branch -D --quiet "${delete_names[@]}"
echo "Deleted ${#delete_names[@]} branch(es). SHAs saved to $backup_file"

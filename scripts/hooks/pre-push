#!/usr/bin/env bash
# Pre-push leak guard.
#
# Installed via the global core.hooksPath (make hooks), so it runs on every push in
# every repo; a repo with its own core.hooksPath keeps its own hooks instead.
# It scans what is about to be pushed: added lines and commit messages.
#
#   Every remote:   common secret patterns (private keys, cloud/git tokens)
#   Public remotes: the machine's denylists (see below)
#   Public = github.com, gitlab.com, bitbucket.org, codeberg.org.
#
# Override for one push:  LEAK_GUARD_ALLOW=1 git push
#
# The denylists are per machine and never live in a repo – publishing them would
# show what they protect. Directory: $LEAK_GUARD_DIR, default ~/.config/leak-guard
#   secret-denylist.txt  fixed strings, one per line (# comments)
#   public-denylist.txt  extended regexes, one per line (# comments)
# Both are matched case-insensitively.

remote_name="$1"
remote_url="$2"
list_dir="${LEAK_GUARD_DIR:-$HOME/.config/leak-guard}"
secret_list="$list_dir/secret-denylist.txt"
public_list="$list_dir/public-denylist.txt"

stdin="$(cat)"

# Keep a repo's own pre-push hook working: core.hooksPath hides .git/hooks.
own_hook="$(git rev-parse --git-path hooks/pre-push 2>/dev/null)"
if [ -x "$own_hook" ] && [ "$(readlink -f "$own_hook")" != "$(readlink -f "$0")" ]; then
    printf '%s\n' "$stdin" | "$own_hook" "$@" || exit $?
fi

if [ -n "$LEAK_GUARD_ALLOW" ]; then
    echo "leak-guard: skipped (LEAK_GUARD_ALLOW is set)" >&2
    exit 0
fi

case "$remote_url" in
    *github.com[:/]* | *gitlab.com[:/]* | *bitbucket.org[:/]* | *codeberg.org[:/]*) public=1 ;;
    *) public=0 ;;
esac

zero="0000000000000000000000000000000000000000"
scan="$(mktemp)"
trap 'rm -f "$scan"' EXIT

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes=$remote_name"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    git log -p --no-color --no-ext-diff --format='@@commit %h%n%B' $range |
        awk '
            /^@@commit / { where = "commit " $2 " message"; inmsg = 1; next }
            /^diff --git / { inmsg = 0; next }
            /^\+\+\+ / { file = substr($0, 7); next }
            /^--- / { next }
            inmsg && NF { print where ": " $0; next }
            /^\+/ { print file ": " substr($0, 2) }
        ' >> "$scan"
done <<EOF
$stdin
EOF

[ -s "$scan" ] || exit 0

if [ "$public" = 1 ] && [ ! -f "$secret_list" ] && [ ! -f "$public_list" ]; then
    echo "leak-guard: no denylists in $list_dir – only secret patterns are checked" >&2
fi

found=0
report() {
    found=1
    printf '  %s\n' "$1" | cut -c1-200 >&2
}

# Common secret shapes (any remote)
patterns='-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{40,}|glpat-[0-9A-Za-z_-]{20}|xox[abposr]-[0-9A-Za-z-]{10,}|sk-[A-Za-z0-9_-]{32,}'
hits="$(grep -E -- "$patterns" "$scan")"
if [ -n "$hits" ]; then
    echo "leak-guard: secret-looking values:" >&2
    while IFS= read -r l; do report "$l"; done <<< "$hits"
fi

if [ "$public" = 1 ] && [ -f "$secret_list" ]; then
    terms="$(grep -v -E '^[[:space:]]*(#|$)' "$secret_list")"
    if [ -n "$terms" ]; then
        hits="$(grep -i -F -f <(printf '%s\n' "$terms") -- "$scan")"
        if [ -n "$hits" ]; then
            echo "leak-guard: infra identifiers from secret-denylist.txt:" >&2
            while IFS= read -r l; do report "$l"; done <<< "$hits"
        fi
    fi
fi

if [ "$public" = 1 ] && [ -f "$public_list" ]; then
    terms="$(grep -v -E '^[[:space:]]*(#|$)' "$public_list")"
    if [ -n "$terms" ]; then
        hits="$(grep -i -E -f <(printf '%s\n' "$terms") -- "$scan")"
        if [ -n "$hits" ]; then
            echo "leak-guard: work references going to a public remote ($remote_name):" >&2
            while IFS= read -r l; do report "$l"; done <<< "$hits"
        fi
    fi
fi

if [ "$found" = 1 ]; then
    echo "leak-guard: push blocked. Fix the commits, or override once: LEAK_GUARD_ALLOW=1 git push" >&2
    exit 1
fi
exit 0

#!/usr/bin/env bash
# Runs after `git rebase` or `git commit --amend` — re-applies symlinks and runs
# pending migrations.
#
# Installed into core.hooksPath, which is global, so this fires on a rebase in ANY
# repo. Resolve our own real path back to the dotfiles checkout we were installed
# from and no-op elsewhere — otherwise every unrelated rebase runs `make link`.
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
origin_repo="${self%/scripts/hooks/*}"
[ "$(git rev-parse --show-toplevel 2>/dev/null)" = "$origin_repo" ] || exit 0

cd "$origin_repo" && make link && make migrate

{
  "_comment": "Template for ~/.claude/settings.local.json (gitignored, per-machine). Use it for per-machine settings and for plugins only one machine should load. Private GitHub plugin repos (e.g. reflections, vault-brain) may stay in the public settings.json: naming a private repo grants no access. What must never be in settings.json is a path to a local file that is not in this repo. NB: a local enabledPlugins block is only honored when settings.json also has an enabledPlugins key (Claude Code issue #27247), so keep that key present in settings.json.",
  "env": {
    "EXAMPLE_MACHINE_VAR": "1"
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "your-private-plugin@your-marketplace": true
  },
  "extraKnownMarketplaces": {
    "your-marketplace": {
      "source": {
        "source": "github",
        "repo": "you/your-marketplace"
      }
    }
  }
}

{
  "model": "opus",
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-no-verify.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-rg-bundled-replace.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-prod-ssh.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "skillOverrides": {
    "reflections": "off",
    "review-mr": "off"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "vault-brain@claude-vault-brain": true,
    "phpstorm-plugin@phpstorm-marketplace": true,
    "reflections@claude-reflections": true,
    "ros7skill@claude-ros7-skill": true
  },
  "extraKnownMarketplaces": {
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    },
    "claude-ros7-skill": {
      "source": {
        "source": "github",
        "repo": "MrOplus/claude-ros7-skill"
      },
      "autoUpdate": true
    },
    "xdebug-mcp": {
      "source": {
        "source": "github",
        "repo": "koriym/xdebug-mcp"
      }
    },
    "claude-vault-brain": {
      "source": {
        "source": "github",
        "repo": "Rozkalns/claude-vault-brain"
      },
      "autoUpdate": true
    },
    "phpstorm-marketplace": {
      "source": {
        "source": "github",
        "repo": "jetbrains/phpstorm-claude-marketplace"
      },
      "autoUpdate": true
    },
    "claude-reflections": {
      "source": {
        "source": "github",
        "repo": "Rozkalns/claude-reflections"
      },
      "autoUpdate": true
    }
  },
  "feedbackDrafts": "off",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}

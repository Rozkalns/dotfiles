{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "MAX_THINKING_TOKENS": "128000",
    "CLAUDE_CODE_DISABLE_MOUSE_CLICKS": "1"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-no-verify.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-rg-bundled-replace.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-prod-ssh.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "diagram-design@diagram-design": false,
    "ros7skill@claude-ros7-skill": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "vault-brain@claude-vault-brain": true
  },
  "extraKnownMarketplaces": {
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    },
    "claude-ros7-skill": {
      "source": {
        "source": "github",
        "repo": "MrOplus/claude-ros7-skill"
      }
    },
    "xdebug-mcp": {
      "source": {
        "source": "github",
        "repo": "koriym/xdebug-mcp"
      }
    },
    "claude-vault-brain": {
      "source": {
        "source": "github",
        "repo": "Rozkalns/claude-vault-brain"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
